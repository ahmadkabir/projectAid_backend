# ---------------------------------------------------------------------------
# Project Aid — backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database Configuration
# Choose: "local" (local MongoDB daemon) or "online" (cloud MongoDB / Atlas)
DATABASE_MODE=online

# Local MongoDB connection URI
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/projectaid

# Online MongoDB connection URI (e.g., MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/projectaid?retryWrites=true&w=majority
# MONGODB_DB=projectaid         # optional database name override
# MONGODB_CONNECT_TIMEOUT=10000 # milliseconds
# MONGODB_POOL_MAX=10           # maximum connection pool size

# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRE=7d

# Email (developers can keep 'console' to print verification emails to the log)
EMAIL_PROVIDER=console
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# AI (optional)
AI_PROVIDER=free
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Payments (Paystack)
# ---------------------------------------------------------------------------
# Use a TEST key (sk_test_...) until the business is verified in Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback
# Must be false outside automated tests. When true, POST /api/orders/:id/payment
# lets a client mark its own order paid without a real charge.
PAYMENTS_MOCK_ENABLED=false

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Local uploads (only thumbnails/avatars are public; paid files stay private).
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
MAX_DOCUMENTATION_FILE_SIZE=26214400
MAX_SOFTWARE_FILE_SIZE=52428800
MAX_GUIDE_FILE_SIZE=10485760
# Keep images below Vercel's 4.5 MB request-body limit.
MAX_IMAGE_SIZE=4194304
# Maximum JSON/form body size (Vercel still caps this at 4.5 MB).
REQUEST_BODY_LIMIT=2mb

# Provider: `local` or `s3` (S3-compatible: AWS S3, Cloudflare R2, MinIO).
# Object storage is opt-in: set STORAGE_PROVIDER=s3 after filling the R2_*
# (or STORAGE_S3_*) variables below.
STORAGE_PROVIDER=local
STORAGE_PREFIX=
STORAGE_DOWNLOAD_URL_TTL=300
STORAGE_UPLOAD_URL_TTL=900

# --- Generic S3 / MinIO ---
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true

# --- Cloudflare R2 (aliases; used when the STORAGE_S3_* equivalents are empty) ---
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 bucket setup (required for direct browser uploads):
#  1. Keep the bucket PRIVATE (no public r2.dev / custom-domain access).
#  2. Add a CORS rule allowing PUT + GET from your frontend origin, e.g.
#       AllowedOrigins: ["http://localhost:5173"]
#       AllowedMethods: ["PUT", "GET", "HEAD"]
#       AllowedHeaders: ["content-type"]
#       ExposeHeaders:   ["etag"]
#       MaxAgeSeconds:   3600
#  3. Create an API token scoped to this bucket with Object Read & Write.
