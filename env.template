# Database Configuration
DB_HOST=localhost
DB_NAME=kasuwa_mall
DB_USERNAME=root        
DB_PASSWORD=
DB_DIALECT=mysql
DB_PORT=3306

# TLS for managed MySQL (Aiven etc.). Download the provider CA to certs/provider-ca.pem.
DB_SSL=false
DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_POOL_MAX=5
# DB_CONNECT_TIMEOUT=20000

# MongoDB (optional, only for `npm run db:check-mongo`)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# MONGODB_DB=
# MONGODB_CONNECT_TIMEOUT=10000

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=mysupersecretkeyformykasuwamallapplicationthatissufficientlylongandsecure2023
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800
# Per-purpose limits (bytes). Documentation: 25 MB, software: 50 MB, guide: 10 MB.
MAX_DOCUMENTATION_FILE_SIZE=26214400
MAX_SOFTWARE_FILE_SIZE=52428800
MAX_GUIDE_FILE_SIZE=10485760
MAX_IMAGE_SIZE=4194304
REQUEST_BODY_LIMIT=2mb

# Project file storage
# 'local' keeps paid files under uploads/private (never served statically).
# 's3' works with AWS S3, Cloudflare R2 or any S3-compatible object store.
STORAGE_PROVIDER=local
# Only used when STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Path-style addressing (required by Cloudflare R2 and MinIO)
STORAGE_S3_FORCE_PATH_STYLE=true
# Optional key prefix inside the bucket, e.g. projectaid/
STORAGE_PREFIX=
# Lifetime of presigned download URLs in seconds (max 3600)
STORAGE_DOWNLOAD_URL_TTL=300
# Lifetime of direct-upload (presigned PUT) URLs in seconds (max 3600)
STORAGE_UPLOAD_URL_TTL=900

# Cloudflare R2 aliases (optional; used when the STORAGE_S3_* values above are empty)
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudinary Configuration (Optional - for cloud file storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (used for email verification)
# EMAIL_PROVIDER: 'console' (dev — emails printed to backend log) or 'smtp' (real delivery)
EMAIL_PROVIDER=console
# SMTP settings (Gmail example — use an App Password, not your account password)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@example.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# AI Configuration (for AI document generation)
AI_PROVIDER=free
# Options: 'free' (template-based, no API needed) or 'openai' (requires OpenAI API key)
# Default: 'free' for development and testing

# OpenAI Configuration (required only if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

